# Copy to .env.local for development. NEVER commit real secrets.
DATABASE_URL="postgresql://user:password@localhost:5432/pintame"

# Auth (used when auth is wired)
AUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL="https://pinta-me.com"

# Resend (transactional email)
RESEND_API_KEY=""
EMAIL_FROM="contato@pinta-me.com"

# Mercado Pago (server-side token + public key for checkout)
MERCADOPAGO_ACCESS_TOKEN=""
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=""

# PayPal (sandbox first)
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_MODE="sandbox"
